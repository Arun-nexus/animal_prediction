{
  "manifest_version": 3,
  "name": "Circle Search AI",
  "version": "1.2",
  "description": "AI-powered visual search using screen capture.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://32.193.13.49:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Circle Search AI"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}